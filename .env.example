# ============================================================================
# Environment variable template. Copy to .env (git-ignored) and fill in real
# values. NOTHING in this repository reads secrets from anywhere but
# environment variables — never hard-code a key/token/ID in source or config.
# Every variable below is optional in dry-run/mock mode (the system default).
# Nothing here activates a live/paid integration by itself — that also
# requires the corresponding adapter to be constructed with
# dry_run=False, live_authorized=True in code, by a human decision.
# ============================================================================

# ---- GoHighLevel: Revenue OS / Marketing Division (docs/09, docs/12) ----
GHL_ACCESS_TOKEN=
GHL_API_BASE_URL=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28
GHL_AGENCY_ID=
GHL_LOCATION_ID=
GHL_WEBHOOK_SIGNING_SECRET=

# ---- GoHighLevel: Open Doors Financial OS v1 (ARCHITECTURE.md, DEPLOYMENT-SOP.md) ----
# OS v1's connection/discovery scripts (scripts/ghl_connection_test.py,
# scripts/ghl_discovery.py) read GHL_LOCATION_ID (shared with the block above) and
# GHL_API_VERSION (shared with the block above) plus this token name specifically —
# both token vars may hold the same underlying Private Integration Token value, they
# are just read by two different subsystems. See ARCHITECTURE.md ("Credentials — two
# separate env-var sets, on purpose") for why GHL_ACCESS_TOKEN wasn't reused/renamed.
GHL_PRIVATE_INTEGRATION_TOKEN=

# ---- Avatar / digital-twin video provider (e.g. HeyGen) — see docs/16 ----
AVATAR_VIDEO_PROVIDER_API_KEY=
AVATAR_VIDEO_WEBHOOK_SIGNING_SECRET=

# ---- Optional separate voice provider (e.g. ElevenLabs) ----
VOICE_PROVIDER_API_KEY=

# ---- iDecide — see docs/15-idecide-integration.md (capability matrix is UNVERIFIED) ----
IDECIDE_API_KEY=
IDECIDE_WEBHOOK_SIGNING_SECRET=

# ---- Social platform adapter — ONLY if GHL Social Planner can't cover a platform ----
SOCIAL_PLATFORM_API_KEY=
SOCIAL_PLATFORM_WEBHOOK_SIGNING_SECRET=

# ---- Optional automation bridges ----
ZAPIER_WEBHOOK_URL=
MAKE_WEBHOOK_URL=

# ---- Storage (only needed once StorageAdapter is pointed at a real backend) ----
STORAGE_BUCKET_NAME=
STORAGE_PROVIDER_API_KEY=
